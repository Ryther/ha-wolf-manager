[Unit]
Description=Wolf streaming managed by HA Wolf Manager
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/wolf-manager-host lifecycle-start
ExecStop=/usr/local/bin/wolf-manager-host lifecycle-stop
TimeoutStartSec=@START_TIMEOUT@
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
