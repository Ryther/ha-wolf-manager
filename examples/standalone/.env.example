# Replace the entire value with the digest from a verified published release.
WOLF_MANAGER_IMAGE=ghcr.io/ryther/ha-wolf-manager@sha256:REPLACE_WITH_VERIFIED_DIGEST
WOLF_PUBLIC_ORIGIN=https://wolf-manager.example.net:8099
# Use a specific LAN address to allow LAN access; keep loopback for local access.
WOLF_MANAGER_BIND_IP=127.0.0.1
