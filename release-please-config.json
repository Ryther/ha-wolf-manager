{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "initial-version": "0.1.0",
  "version-file": "version.txt",
  "draft": true,
  "force-tag-creation": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "component": "ha-wolf-manager",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==\"wolf-core\" || @.name.value==\"ha-wolf-manager\" || @.name.value==\"wolf-manager-host\")].version" },
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "yaml", "path": "wolf_manager/config.yaml", "jsonpath": "$.version" }
      ]
    }
  }
}
